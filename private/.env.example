# ─────────────────────────────────────────────────────────────
# CENTYNELLA-CORE · plantilla de variables de entorno
#
# Copia según el ambiente:
#   private/.env.sandbox      -> desarrollo (developer)
#   private/.env.production   -> producción
# Se elige con la variable de sistema APP_ENV (por defecto: sandbox).
# Los archivos reales están en .gitignore: NUNCA se versionan.
# En AWS/contenedores usa variables de entorno o Secrets Manager;
# las variables del sistema tienen prioridad sobre este archivo.
# ─────────────────────────────────────────────────────────────

APP_NAME=CENTYNELLA-CORE
APP_ENV=sandbox
APP_VERSION=0.1.0

# Swagger (/docs), ReDoc (/redoc) y /openapi.json
DOCS_ENABLED=true

# MongoDB Atlas. Un mismo cluster con una base de datos por ambiente:
#   sandbox    -> centynella_sandbox
#   production -> centynella_production
# Recomendado: un usuario de base de datos distinto por ambiente, con permisos solo sobre su base.
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/
MONGODB_DB=centynella_sandbox
MONGODB_TIMEOUT_MS=5000

# Orígenes CORS permitidos (el shell del MFE), separados por coma
CORS_ORIGINS=http://localhost:5173
