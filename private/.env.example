# ─────────────────────────────────────────────────────────────
# CENTYNELLA-CORE · plantilla de variables de entorno
#
# Copia según el ambiente:
#   private/.env.sandbox      -> desarrollo (developer)
#   private/.env.production   -> producción
# Se elige con la variable de sistema APP_ENV (por defecto: sandbox).
# Los archivos reales están en .gitignore: NUNCA se versionan.
# En AWS/contenedores usa variables de entorno o Secrets Manager;
# las variables del sistema tienen prioridad sobre este archivo.
# ─────────────────────────────────────────────────────────────

APP_NAME=CENTYNELLA-CORE
APP_ENV=sandbox
APP_VERSION=0.1.0

# Swagger (/docs), ReDoc (/redoc) y /openapi.json
DOCS_ENABLED=true

# MongoDB Atlas. Un mismo cluster con una base de datos por ambiente:
#   sandbox    -> centynella_sandbox
#   production -> centynella_production
# Recomendado: un usuario de base de datos distinto por ambiente, con permisos solo sobre su base.
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/
MONGODB_DB=centynella_sandbox
MONGODB_TIMEOUT_MS=5000

# ── Bitácora ─────────────────────────────────────────────────────────────────
# Base de datos SEPARADA de la de negocio (mismo cluster), una por ambiente:
#   sandbox -> centynella_logs_sandbox · production -> centynella_logs_production
MONGODB_LOGS_DB=centynella_logs_sandbox
# Días que se conservan los eventos (un índice TTL de MongoDB borra los viejos solos)
LOG_RETENTION_DAYS=30
# Nivel mínimo que se guarda: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_MIN_LEVEL=INFO

# Orígenes CORS permitidos (el shell del MFE), separados por coma.
# Lista los orígenes EXACTOS: el comodín `*` se ignora (la sesión usa cookies) y en producción falla.
CORS_ORIGINS=http://localhost:5173

# ── Autenticación ────────────────────────────────────────────────────────────
# Secreto para firmar los JWT (mínimo 32 caracteres). Genera uno con:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Usa uno DISTINTO por ambiente. En AWS, desde Secrets Manager. Sin él la app no arranca.
JWT_SECRET_KEY=<genera-un-secreto-de-64-caracteres>
# Vida de las sesiones (opcionales; valores por defecto):
# ACCESS_TOKEN_TTL_MINUTES=15
# REFRESH_TOKEN_TTL_DAYS=14
# MAX_FAILED_LOGINS=5
# LOCKOUT_MINUTES=15
# REGISTRATION_ENABLED=true

# URL pública del shell (arma el enlace del correo de recuperación de contraseña)
FRONTEND_URL=http://localhost:5173

# Administrador inicial: se crea al arrancar SOLO si no existe ningún usuario.
# Defínelo para el primer arranque y luego puedes quitarlo.
BOOTSTRAP_ADMIN_EMAIL=admin@tu-dominio.com
BOOTSTRAP_ADMIN_PASSWORD=<contraseña-inicial-de-8+-caracteres>
BOOTSTRAP_ADMIN_NAME=Administrador

# Preparado para "Continuar con Google" (aún sin implementar)
# GOOGLE_CLIENT_ID=
